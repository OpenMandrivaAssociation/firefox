--- a/build/moz.configure/nss.configure	2026-11-25 00:36:11.566854617 +0100
+++ b/build/moz.configure/nss.configure	2026-11-25 00:35:56.032903610 +0100
@@ -46,10 +46,16 @@
 
 @depends(nss_pkg, build_environment)
 def nss_config(nss_pkg, build_env):
+    # dist/include/nss contains only the in-tree mozpkix headers. Firefox
+    # links that static mozpkix even with --with-system-nss. Those headers
+    # must be searched before the system NSS include dir: NSS 3.134's
+    # mozpkix adds TrustDomain virtuals that this tree's mozpkix and its
+    # callers do not have, and compiling against the system header while
+    # linking the in-tree library breaks the vtable.
     cflags = ["-I%s" % os.path.join(build_env.dist, "include", "nss")]
     libs = None
     if nss_pkg:
-        cflags = list(nss_pkg.cflags) + cflags
+        cflags = cflags + list(nss_pkg.cflags)
         libs = nss_pkg.libs
     return namespace(cflags=cflags, libs=libs)
 
