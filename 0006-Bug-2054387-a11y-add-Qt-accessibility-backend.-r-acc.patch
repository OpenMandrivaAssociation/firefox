+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "AccessibleWrap.h"
+#include "QtAccessible.h"
+
+#include "LocalAccessible-inl.h"
+
+#pragma GCC visibility push(default)
+#include <QAccessible>
+#pragma GCC visibility pop
+
+using namespace mozilla;
+using namespace mozilla::a11y;
+
+AccessibleWrap::AccessibleWrap(nsIContent* aContent, DocAccessible* aDoc)
+    : LocalAccessible(aContent, aDoc) {}
+
+AccessibleWrap::~AccessibleWrap() { MOZ_ASSERT(!mQtAccessible); }
+
+void AccessibleWrap::Shutdown() {
+  ShutdownQtAccessible();
+  LocalAccessible::Shutdown();
+}
+
+void AccessibleWrap::ShutdownQtAccessible() {
+  if (!mQtAccessible) {
+    return;
+  }
+  mQtAccessible->ClearAcc();
+  const QAccessible::Id id = QAccessible::uniqueId(mQtAccessible);
+  if (id) {
+    QAccessible::deleteAccessibleInterface(id);
+  }
+  mQtAccessible = nullptr;
+}
+
+void AccessibleWrap::AdoptQtAccessible(QtAccessible* aIface) {
+  MOZ_ASSERT(aIface);
+  MOZ_ASSERT(!mQtAccessible || mQtAccessible == aIface);
+  mQtAccessible = aIface;
+}
+
+void AccessibleWrap::GetNativeInterface(void** aOutAccessible) {
+  *aOutAccessible = nullptr;
+  if (IsDefunct()) {
+    return;
+  }
+
+  if (!mQtAccessible) {
+    QObject* obj = nullptr;
+    if (IsRoot()) {
+      if (QWindow* win = QtAccessible::WindowFor(this)) {
+        obj = win;
+        // May invoke the factory, which adopts into this wrap.
+        (void)QAccessible::queryAccessibleInterface(obj);
+      }
+    }
+    if (!mQtAccessible) {
+      mQtAccessible = new QtAccessible(this, obj);
+      QAccessible::registerAccessibleInterface(mQtAccessible);
+    }
+  }
+  *aOutAccessible = mQtAccessible;
+}
diff --git a/accessible/qt/AccessibleWrap.h b/accessible/qt/AccessibleWrap.h
new file mode 100644
index 000000000000..fdb63cfdfd7c
--- /dev/null
+++ b/accessible/qt/AccessibleWrap.h
@@ -0,0 +1,42 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef mozilla_a11y_AccessibleWrap_h_
+#define mozilla_a11y_AccessibleWrap_h_
+
+#include "LocalAccessible.h"
+
+namespace mozilla {
+namespace a11y {
+
+class QtAccessible;
+
+/**
+ * Qt QAccessible-backed wrap for local accessibles.
+ * Native interface is a QtAccessible* (QAccessibleInterface).
+ */
+class AccessibleWrap : public LocalAccessible {
+ public:
+  AccessibleWrap(nsIContent* aContent, DocAccessible* aDoc);
+  virtual ~AccessibleWrap();
+
+  virtual void Shutdown() override;
+  virtual void GetNativeInterface(void** aOutAccessible) override;
+
+  QtAccessible* GetQtAccessible() const { return mQtAccessible; }
+
+  // Adopt an interface created by the QAccessible factory (not yet registered
+  // by us — Qt will register it).
+  void AdoptQtAccessible(QtAccessible* aIface);
+
+  void ShutdownQtAccessible();
+
+ private:
+  QtAccessible* mQtAccessible = nullptr;
+};
+
+}  // namespace a11y
+}  // namespace mozilla
+
+#endif
