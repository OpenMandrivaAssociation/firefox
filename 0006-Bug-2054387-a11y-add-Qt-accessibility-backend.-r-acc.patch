+
+QString QtAccessible::attributes(int offset, int* startOffset,
+                                  int* endOffset) const {
+  // QAccessible expects "key:value;key:value;" (same shape as IA2).
+  if (startOffset) {
+    *startOffset = 0;
+  }
+  if (endOffset) {
+    *endOffset = 0;
+  }
+  HyperTextAccessibleBase* ht = AsHyperText();
+  if (!ht) {
+    if (endOffset) {
+      *endOffset = characterCount();
+    }
+    return {};
+  }
+  int32_t start = 0;
+  int32_t end = 0;
+  RefPtr<AccAttributes> attrs =
+      ht->TextAttributes(/* aIncludeDefAttrs */ true, offset, &start, &end);
+  if (startOffset) {
+    *startOffset = start;
+  }
+  if (endOffset) {
+    *endOffset = end;
+  }
+  if (!attrs) {
+    return {};
+  }
+  QString out;
+  for (auto iter : *attrs) {
+    nsAutoString name;
+    nsAutoString value;
+    iter.NameAsString(name);
+    iter.ValueAsString(value);
+    // Escape ':', ';', '=', ',', '\\' for attribute parsers.
+    auto escape = [](const nsAString& in) {
+      nsString s(in);
+      for (uint32_t i = 0; i < s.Length();) {
+        const char16_t c = s[i];
+        if (c == u':' || c == u';' || c == u'=' || c == u',' || c == u'\\') {
+          s.Insert(u'\\', i);
+          i += 2;
+        } else {
+          ++i;
+        }
+      }
+      return ToQString(s);
+    };
+    out += escape(name);
+    out += QLatin1Char(':');
+    out += escape(value);
+    out += QLatin1Char(';');
+  }
+  return out;
+}
