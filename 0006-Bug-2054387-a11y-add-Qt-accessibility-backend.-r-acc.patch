+QAccessible::Role QtAccessible::role() const {
+  if (!isValid()) {
+    return QAccessible::NoRole;
+  }
+  return RoleFor(mAcc->Role());
+}
+
+QAccessible::State QtAccessible::state() const {
+  if (!isValid()) {
+    QAccessible::State st;
+    st.invalid = true;
+    return st;
+  }
+  return StateFor(mAcc->State());
+}
