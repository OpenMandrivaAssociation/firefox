+void QtAccessible::setSelection(int selectionIndex, int startOffset,
+                                int endOffset) {
+  if (selectionIndex != 0) {
+    return;
+  }
+  if (HyperTextAccessibleBase* ht = AsHyperText()) {
+    ht->SetSelectionBoundsAt(0, startOffset, endOffset);
+  }
