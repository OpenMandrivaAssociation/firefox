diff --git a/browser/config/mozconfigs/linux64/qt-opt b/browser/config/mozconfigs/linux64/qt-opt
new file mode 100644
index 000000000000..ea52f1277d1d
--- /dev/null
+++ b/browser/config/mozconfigs/linux64/qt-opt
@@ -0,0 +1,20 @@
+# Experimental Linux64 Qt (cairo-qt) opt build.
+# Requires Qt6 (Core/Gui/Widgets/PrintSupport/DBus) on the build host / image.
+# Not yet part of the default Firefox CI graph until worker images ship Qt6.
+
+. "$topsrcdir/build/unix/mozconfig.unix"
+
+ac_add_options --enable-default-toolkit=cairo-qt
+ac_add_options --enable-update-channel=${MOZ_UPDATE_CHANNEL:-default}
+ac_add_options --disable-tests
+ac_add_options --enable-release
+ac_add_options --enable-optimize
+ac_add_options --disable-debug
+ac_add_options --enable-webrtc
+ac_add_options --enable-pulseaudio
+
+# Package js shell.
+export MOZ_PACKAGE_JSSHELL=1
+export MOZILLA_OFFICIAL=1
+
+. "$topsrcdir/build/mozconfig.common.override"
