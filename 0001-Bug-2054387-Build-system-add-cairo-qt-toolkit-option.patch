+if CONFIG["MOZ_WIDGET_TOOLKIT"] == "qt" and CONFIG["COMPILE_ENVIRONMENT"]:
+    OS_LIBS += CONFIG["MOZ_QT6_LIBS"]
+    # Fontconfig/FreeType used by gfx for Linux desktop.
+    OS_LIBS += CONFIG["FT2_LIBS"]
+    # System cairo: gfxFcPlatformFontList font options (not tree cairo).
