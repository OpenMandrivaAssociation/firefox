diff -ruN a/gfx/system-harfbuzz-visibility.h b/gfx/system-harfbuzz-visibility.h
--- a/gfx/system-harfbuzz-visibility.h	1970-01-01 01:00:00.000000000 +0100
+++ b/gfx/system-harfbuzz-visibility.h	2026-07-27 05:02:21.564624578 +0200
@@ -0,0 +1,20 @@
+/* -*- Mode: C++; tab-width: 8; indent-tabs-mode: nil; c-basic-offset: 2 -*- */
+/* Force default visibility on system HarfBuzz API declarations.
+ *
+ * Gecko uses -fvisibility=hidden (see config/gcc_hidden.h). System HarfBuzz
+ * headers declare functions as plain `extern`, so the compiler records
+ * hidden undefined references. libharfbuzz.so exports those symbols with
+ * DEFAULT visibility, and ld.lld then errors with:
+ *   undefined hidden symbol: hb_face_destroy
+ *
+ * Redefining HB_EXTERN only adjusts ELF visibility of the *import*
+ * declarations so they match the shared library. It does not replace or
+ * stub any HarfBuzz functions — hb_*_destroy / reference counting still
+ * resolve to the real system library implementations (no memory leaks).
+ */
+#ifndef MOZ_SYSTEM_HARFBUZZ_VISIBILITY_H_
+#define MOZ_SYSTEM_HARFBUZZ_VISIBILITY_H_
+#ifndef HB_EXTERN
+#define HB_EXTERN __attribute__((visibility("default"))) extern
+#endif
+#endif /* MOZ_SYSTEM_HARFBUZZ_VISIBILITY_H_ */
