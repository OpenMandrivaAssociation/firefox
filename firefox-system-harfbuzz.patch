 set_config("MOZ_SYSTEM_WEBP", depends(when=system_webp)(lambda: True))
 
 
+# System HarfBuzz (distro packaging)
+# ==============================================================
+# Upstream vendors HarfBuzz; prefer the shared system library when requested.
+with only_when(compile_environment):
+    system_lib_option(
+        "--with-system-harfbuzz",
+        help="Use system HarfBuzz (located with pkgconfig)",
+        when=use_pkg_config,
+    )
+
+    # Subset is used by Skia PDF.
+    system_harfbuzz = pkg_check_modules(
+        "MOZ_HARFBUZZ",
+        "harfbuzz >= 8.0.0 harfbuzz-subset >= 8.0.0",
+        when="--with-system-harfbuzz",
+    )
+    set_config("MOZ_SYSTEM_HARFBUZZ", True, when=system_harfbuzz)
+
+    # Firefox compiles with -fvisibility=hidden (gcc_hidden.h). System
+    # HarfBuzz headers declare APIs as plain `extern`, so call sites become
+    # hidden undefined symbols and fail to link against libharfbuzz.so
+    # (DEFAULT visibility). Force HB_EXTERN to default visibility in *every*
+    # TU: gfxFontEntry.h / gfxFontUtils.h call hb_*_destroy from inline
+    # destructors, so any consumer of those headers needs the fix — not just
+    # thebes/skia. This only affects ELF visibility of imports; it does not
+    # change HarfBuzz refcounting or skip destroys (no leak risk).
+    @depends(system_harfbuzz, build_environment)
+    @imports(_from="os.path", _import="join")
+    def system_harfbuzz_visibility_flags(system_harfbuzz, build_env):
+        if not system_harfbuzz:
+            return []
+        header = join(build_env.topsrcdir, "gfx", "system-harfbuzz-visibility.h")
+        return ["-include", header]
+
+    # Inject globally so layout/inspector, dom, intl, netwerk, etc. all get it.
+    @depends(os_cxxflags, system_harfbuzz_visibility_flags)
+    def os_cxxflags_with_system_harfbuzz(flags, hb_flags):
+        return list(flags) + list(hb_flags)
+
+    @depends(os_cflags, system_harfbuzz_visibility_flags)
+    def os_cflags_with_system_harfbuzz(flags, hb_flags):
+        return list(flags) + list(hb_flags)
+
+    set_config("OS_CXXFLAGS", os_cxxflags_with_system_harfbuzz)
+    set_config("OS_CFLAGS", os_cflags_with_system_harfbuzz)
+
+
 # Build Freetype in the tree
 # ==============================================================
 @depends(target)
