+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef widget_qt_WakeLockListener_h
+#define widget_qt_WakeLockListener_h
+
+#include "mozilla/Maybe.h"
+#include "nsHashKeys.h"
+#include "nsIDOMWakeLockListener.h"
+#include "nsRefPtrHashtable.h"
+#include "nsString.h"
+
+namespace mozilla::widget {
+
+/**
+ * Maps Gecko wake-lock topics to freedesktop D-Bus inhibit cookies via QtDBus
+ * (ScreenSaver and PowerManagement.Inhibit). Enough for media playback so
+ * the session does not blank the screen or suspend.
+ */
+class WakeLockListener final : public nsIDOMMozWakeLockListener {
+ public:
+  NS_DECL_ISUPPORTS
+  NS_DECL_NSIDOMMOZWAKELOCKLISTENER
+
+  WakeLockListener();
+
+ private:
+  ~WakeLockListener();
+
+  class TopicState final {
+   public:
+    NS_INLINE_DECL_REFCOUNTING(TopicState)
+
+    explicit TopicState(const nsACString& aTopic) : mTopic(aTopic) {}
+
+    nsresult Inhibit();
+    nsresult Uninhibit();
+    bool IsInhibited() const { return mCookie.isSome(); }
+
+   private:
+    ~TopicState() { (void)Uninhibit(); }
+
+    nsCString mTopic;
+    // Cookie from org.freedesktop.ScreenSaver.Inhibit
+    mozilla::Maybe<uint32_t> mCookie;
+    // Cookie from org.freedesktop.PowerManagement.Inhibit
+    mozilla::Maybe<uint32_t> mPowerCookie;
+  };
+
+  nsRefPtrHashtable<nsCStringHashKey, TopicState> mTopics;
+};
+
+}  // namespace mozilla::widget
+
+#endif
diff --git a/widget/qt/ci/README.md b/widget/qt/ci/README.md
new file mode 100644
index 000000000000..bc611b5b1f74
--- /dev/null
+++ b/widget/qt/ci/README.md
@@ -0,0 +1,53 @@
+# Qt (cairo-qt) CI helpers
+
+Firefox upstream Taskcluster does not yet ship a `cairo-qt` build graph.
+Packagers and local gates can use:
+
+```bash
+export MOZCONFIG=$PWD/mozconfig.qt
+./mach configure
+./widget/qt/ci/smoke-configure.sh
+./mach build
+```
+
+`smoke-configure.sh` verifies:
+
+- `MOZ_WIDGET_QT` / toolkit=`qt`
+- DBus enabled
+- optional dbusmenu-qt6 and NECKO_WIFI_DBUS
+- first-party Qt sources do not include GIO
+
+## Suggested packaging CI stages
+
+1. **configure** — run `./mach configure` with the distro `mozconfig.qt`
+2. **smoke-configure** — this script
+3. **build** — `./mach build` (or `./mach build binaries` for faster iteration)
+4. **manual Plasma checklist** — see `widget/qt/PACKAGING.md`
+
+Wire steps 1–3 into your distro pipeline (OpenMandriva ABF, OBS, GitLab CI, etc.).
+
+## Taskcluster
+
+An experimental job is defined in `taskcluster/kinds/build/linux-qt.yml`
+(`linux64-qt/opt`, Treeherder symbol **Bq**, tier 3).
+
+- Mozconfig: `browser/config/mozconfigs/linux64/qt-opt`
+- `run-on-projects: []` until Firefox Linux docker images ship Qt6
+- Try: `./mach try fuzzy -q 'linux64-qt'`
+
+## Runtime smoke
+
+After a local or packager build:
+
+```bash
+export MOZCONFIG=$PWD/mozconfig.qt
+./widget/qt/ci/smoke-configure.sh
+./widget/qt/ci/smoke-runtime.sh
+```
+
+## Source-test (Taskcluster, no Qt SDK)
+
+`source-test/qt-source-smoke` (Treeherder **Qt(s)**) runs when Qt-related
+paths change. It checks mozconfigs, scripts, and first-party GIO absence.
+
+Full binary builds remain `linux64-qt/opt` (try-only until docker has Qt6).
diff --git a/widget/qt/ci/smoke-configure.sh b/widget/qt/ci/smoke-configure.sh
new file mode 100644
index 000000000000..c458519d7adf
--- /dev/null
+++ b/widget/qt/ci/smoke-configure.sh
@@ -0,0 +1,99 @@
+#!/usr/bin/env bash
+# Smoke-check a cairo-qt configure tree. Intended for packaging CI / local gates.
+# Usage: MOZCONFIG=path/to/mozconfig.qt widget/qt/ci/smoke-configure.sh [objdir]
+set -euo pipefail
+
+ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
+cd "$ROOT"
+
+if [[ -z "${MOZCONFIG:-}" ]]; then
+  if [[ -f "$ROOT/mozconfig.qt" ]]; then
+    export MOZCONFIG="$ROOT/mozconfig.qt"
+  else
+    echo "error: set MOZCONFIG to a cairo-qt mozconfig" >&2
+    exit 1
+  fi
+fi
+
+OBJDIR="${1:-}"
+if [[ -z "$OBJDIR" ]]; then
+  # shellcheck disable=SC1090
+  OBJDIR=$(python3 - <<'PY'
+import os, re
+path=os.environ["MOZCONFIG"]
+text=open(path).read()
+m=re.search(r"MOZ_OBJDIR\s*=\s*@TOPSRCDIR@/(\S+)", text)
+print(m.group(1) if m else "obj-qt")
+PY
+)
+fi
+
+CONFIG_H="$ROOT/$OBJDIR/mozilla-config.h"
+STATUS="$ROOT/$OBJDIR/config.status"
+
+if [[ ! -f "$CONFIG_H" ]]; then
+  echo "error: $CONFIG_H missing — run ./mach configure first" >&2
+  exit 1
+fi
+
+fail=0
+check_define() {
+  local name="$1" expect="${2:-}"
+  if ! grep -q "#define $name" "$CONFIG_H"; then
+    echo "FAIL: missing #define $name in mozilla-config.h"
+    fail=1
+    return
+  fi
+  if [[ -n "$expect" ]]; then
+    if ! grep -q "#define $name $expect" "$CONFIG_H"; then
+      echo "WARN: $name present but not exactly '$expect'"
+    fi
+  fi
+  echo "OK: $name"
+}
+
+echo "== cairo-qt configure smoke ($OBJDIR) =="
+check_define MOZ_WIDGET_QT 1
+check_define MOZ_ENABLE_DBUS 1
+
+# Optional but strongly recommended on Plasma packs.
+if grep -q "MOZ_ENABLE_DBUSMENU_QT 1" "$CONFIG_H"; then
+  echo "OK: MOZ_ENABLE_DBUSMENU_QT 1"
+else
+  echo "WARN: MOZ_ENABLE_DBUSMENU_QT not set (libdbusmenu-qt6 missing at configure)"
+fi
+
+if grep -q "NECKO_WIFI_DBUS 1" "$CONFIG_H"; then
+  echo "OK: NECKO_WIFI_DBUS 1"
+else
+  echo "WARN: NECKO_WIFI_DBUS not enabled"
+fi
+
+# Toolkit string in config.status
+if [[ -f "$STATUS" ]]; then
+  if grep -q "MOZ_WIDGET_TOOLKIT.: .qt" "$STATUS" || grep -q "'MOZ_WIDGET_TOOLKIT': 'qt'" "$STATUS"; then
+    echo "OK: MOZ_WIDGET_TOOLKIT=qt"
+  else
+    echo "FAIL: MOZ_WIDGET_TOOLKIT is not qt in config.status"
+    fail=1
+  fi
+fi
+
+# First-party sources must not pull GIO on the Qt path.
+echo "== first-party GIO scan (widget/qt, unixdesktop, shell Qt) =="
+if rg -n "gio/gio\.h|g_dbus_proxy|GDBusProxy" \
+    --glob '!ci/**' \
+    widget/qt toolkit/system/unixdesktop \
+    browser/components/shell/nsQtShellService.cpp \
+    netwerk/wifi/dbus/QtDbusWifiScanner.cpp 2>/dev/null; then
+  echo "FAIL: GIO symbols found in first-party Qt paths"
+  fail=1
+else
+  echo "OK: no GIO in first-party Qt paths"
+fi
+
+if [[ "$fail" -ne 0 ]]; then
+  echo "smoke-configure: FAILED"
+  exit 1
+fi
+echo "smoke-configure: PASSED"
diff --git a/widget/qt/ci/smoke-runtime.sh b/widget/qt/ci/smoke-runtime.sh
new file mode 100644
index 000000000000..b445fb5a4e9f
--- /dev/null
+++ b/widget/qt/ci/smoke-runtime.sh
@@ -0,0 +1,117 @@
+#!/usr/bin/env bash
+# Runtime smoke checks for a built cairo-qt tree.
+# Usage: MOZCONFIG=…/mozconfig.qt widget/qt/ci/smoke-runtime.sh [objdir]
+set -euo pipefail
+
+ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
+cd "$ROOT"
+
+if [[ -z "${MOZCONFIG:-}" ]]; then
+  if [[ -f "$ROOT/mozconfig.qt" ]]; then
+    export MOZCONFIG="$ROOT/mozconfig.qt"
+  else
+    echo "error: set MOZCONFIG" >&2
+    exit 1
+  fi
+fi
+
+OBJDIR="${1:-}"
+if [[ -z "$OBJDIR" ]]; then
+  OBJDIR=$(python3 - <<'PY'
+import os, re
+text=open(os.environ["MOZCONFIG"]).read()
+m=re.search(r"MOZ_OBJDIR\s*=\s*@TOPSRCDIR@/(\S+)", text)
+print(m.group(1) if m else "obj-qt")
+PY
+)
+fi
+
+BIN="$ROOT/$OBJDIR/dist/bin/firefox"
+XUL="$ROOT/$OBJDIR/dist/bin/libxul.so"
+fail=0
+
+echo "== cairo-qt runtime smoke ($OBJDIR) =="
+
+if [[ ! -x "$BIN" ]]; then
+  echo "FAIL: missing $BIN"
+  exit 1
+fi
+echo "OK: firefox binary"
+
+if [[ ! -f "$XUL" ]]; then
+  echo "FAIL: missing $XUL"
+  exit 1
+fi
+
+# Qt toolkit linkage
+if ! ldd "$XUL" 2>/dev/null | grep -q 'libQt6'; then
+  echo "FAIL: libxul not linked to Qt6"
+  fail=1
+else
+  echo "OK: libxul links Qt6"
+  ldd "$XUL" 2>/dev/null | grep 'libQt6' | sed 's/^/  /' | head -10
+fi
+
+# Preferred global-menu backend
+if ldd "$XUL" 2>/dev/null | grep -q 'libdbusmenu-qt6'; then
+  echo "OK: dbusmenu-qt6 linked"
+else
+  echo "WARN: dbusmenu-qt6 not linked (optional)"
+fi
+
+# --version must work headless
+ver_out="$("$BIN" --version 2>&1 || true)"
+if echo "$ver_out" | grep -qi 'Mozilla Firefox'; then
+  echo "OK: firefox --version: $(echo "$ver_out" | head -1)"
+else
+  echo "FAIL: firefox --version unexpected: $ver_out"
+  fail=1
+fi
+
+# Headless start/stop (no full UI session required)
+# Use a temp profile; timeout if it hangs.
+PROFILE=$(mktemp -d)
+cleanup() { rm -rf "$PROFILE"; }
+trap cleanup EXIT
+
+set +e
+timeout 30s env MOZ_HEADLESS=1 QT_QPA_PLATFORM=offscreen \
+  "$BIN" --headless -profile "$PROFILE" -no-remote \
+  about:blank >/tmp/qt-firefox-headless.log 2>&1 &
+pid=$!
+# Give it a few seconds to start
+sleep 10
+if kill -0 "$pid" 2>/dev/null; then
+  echo "OK: headless process running (pid $pid)"
+  kill "$pid" 2>/dev/null || true
+  wait "$pid" 2>/dev/null || true
+else
+  wait "$pid"
+  rc=$?
+  if [[ $rc -eq 124 ]]; then
+    echo "OK: headless ran until timeout (expected)"
+  elif grep -qi 'headless mode' /tmp/qt-firefox-headless.log 2>/dev/null; then
+    # Started in headless then exited (crash or early quit) — soft fail for CI.
+    echo "WARN: headless exited rc=$rc after enabling headless — log:"
+    tail -25 /tmp/qt-firefox-headless.log | sed 's/^/  /'
+  else
+    echo "FAIL: headless did not start (rc=$rc)"
+    tail -25 /tmp/qt-firefox-headless.log | sed 's/^/  /'
+    fail=1
+  fi
+fi
+set -e
+
+# XPCOM component registration sanity: toolkit string in application.ini
+appini="$ROOT/$OBJDIR/dist/bin/application.ini"
+if [[ -f "$appini" ]]; then
+  echo "OK: application.ini present"
+else
+  echo "WARN: application.ini missing"
+fi
+
+if [[ "$fail" -ne 0 ]]; then
+  echo "smoke-runtime: FAILED"
+  exit 1
+fi
+echo "smoke-runtime: PASSED"
