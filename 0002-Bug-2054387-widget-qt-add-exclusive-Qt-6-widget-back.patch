+
+already_AddRefed<nsDragService> nsDragService::GetInstance() {
+  if (!sDragServiceInstance) {
+    sDragServiceInstance = new nsDragService();
+    ClearOnShutdown(&sDragServiceInstance);
+  }
+  return do_AddRef(sDragServiceInstance);
+}
