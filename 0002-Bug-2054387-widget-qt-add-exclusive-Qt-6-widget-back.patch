+void GeoclueLocationBridge::OnLocationUpdated(const QDBusObjectPath& aOld,
+                                              const QDBusObjectPath& aNew) {
+  (void)aOld;
+  if (!mOwner || aNew.path().isEmpty()) {
+    return;
+  }
+  mOwner->OnLocationPath(
+      nsDependentCString(aNew.path().toUtf8().constData()));
+}
