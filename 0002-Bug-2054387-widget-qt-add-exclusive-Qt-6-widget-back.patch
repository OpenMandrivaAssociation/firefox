+CXXFLAGS += CONFIG["MOZ_QT6_CFLAGS"]
+OS_LIBS += CONFIG["MOZ_QT6_LIBS"]
+
+# GLib/GObject for optional dbusmenu-glib fallback and GMainContext pump
+# (libwebrtc PipeWire portal still uses GIO internally; first-party Qt code
+# uses QtDBus only).
+if CONFIG["GLIB_CFLAGS"]:
+    CXXFLAGS += CONFIG["GLIB_CFLAGS"]
+if CONFIG["GLIB_LIBS"]:
+    OS_LIBS += CONFIG["GLIB_LIBS"]
+
+# Preferred Plasma global-menu backend (libdbusmenu-qt6).
+if CONFIG["MOZ_ENABLE_DBUSMENU_QT"]:
+    CXXFLAGS += CONFIG["MOZ_DBUSMENU_QT_CFLAGS"]
+    OS_LIBS += CONFIG["MOZ_DBUSMENU_QT_LIBS"]
+
+# Private QPA headers (QPlatformNativeInterface). Detected via pkg-config
+# Qt6Gui includedir + modversion (see toolkit/moz.configure).
+# Resolves #include <qpa/qplatformnativeinterface.h>
+if CONFIG["MOZ_QT_PRIVATE_GUI_CFLAGS"]:
+    CXXFLAGS += CONFIG["MOZ_QT_PRIVATE_GUI_CFLAGS"]
+
+# Wayland-EGL for wl_egl_window used as EGLNativeWindowType on Wayland QPA.
+if CONFIG["MOZ_WAYLAND_LIBS"]:
+    CXXFLAGS += CONFIG["MOZ_WAYLAND_CFLAGS"]
+    OS_LIBS += CONFIG["MOZ_WAYLAND_LIBS"]
+    OS_LIBS += ["wayland-egl"]
+
+# Qt headers use Q_DECL_EXPORT/IMPORT with default visibility; they conflict
+# with Firefox's forced -fvisibility=hidden include.
+NoVisibilityFlags()
+
+# Qt headers require exceptions and RTTI in some builds; keep aligned with Qt.
+if CONFIG["MOZ_X11"]:
+    CXXFLAGS += CONFIG["MOZ_X11_CFLAGS"]
diff --git a/widget/qt/nsAppShell.cpp b/widget/qt/nsAppShell.cpp
