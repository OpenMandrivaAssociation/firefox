diff --git a/widget/qt/QtWaylandVsyncSource.cpp b/widget/qt/QtWaylandVsyncSource.cpp
new file mode 100644
index 000000000000..68932173471f
--- /dev/null
+++ b/widget/qt/QtWaylandVsyncSource.cpp
@@ -0,0 +1,195 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "QtWaylandVsyncSource.h"
+
+#include "MainThreadUtils.h"
+#include "mozilla/StaticPrefs_layout.h"
+#include "mozilla/widget/WindowOcclusionState.h"
+#include "nsWindow.h"
+#include "QtWindowBridge.h"
+
+#include <wayland-client.h>
+
+#pragma GCC visibility push(default)
+#include <QGuiApplication>
+#include <qpa/qplatformnativeinterface.h>
+#pragma GCC visibility pop
+
+namespace mozilla {
+
+using widget::OcclusionState;
+
+namespace {
+
+const struct wl_callback_listener kFrameListener = {
+    // done
+    [](void* data, wl_callback* callback, uint32_t time) {
+      auto* self = static_cast<QtWaylandVsyncSource*>(data);
+      // Wayland dispatches on the Qt event thread (main).
+      self->FrameCallback(time);
+      wl_callback_destroy(callback);
+    },
+};
+
+}  // namespace
+
+QtWaylandVsyncSource::QtWaylandVsyncSource(nsWindow* aWindow)
+    : mMutex("QtWaylandVsyncSource"),
+      mWindow(aWindow),
+      mVsyncRate(TimeDuration::FromMilliseconds(1000.0 / 60.0)),
+      mLastVsyncTimeStamp(TimeStamp::Now()) {
+  MOZ_ASSERT(NS_IsMainThread());
+}
+
+QtWaylandVsyncSource::~QtWaylandVsyncSource() {
+  MutexAutoLock lock(mMutex);
+  if (mCallback) {
+    wl_callback_destroy(mCallback);
+    mCallback = nullptr;
+  }
+}
+
+TimeDuration QtWaylandVsyncSource::GetVsyncRate() {
+  MutexAutoLock lock(mMutex);
+  return mVsyncRate;
+}
+
+void QtWaylandVsyncSource::CalculateVsyncRateLocked(
+    const MutexAutoLock& /*aProofOfLock*/, TimeStamp aNow) {
+  if (!mLastVsyncTimeStamp.IsNull()) {
+    const TimeDuration delta = aNow - mLastVsyncTimeStamp;
+    // EMA toward observed interval; clamp to ~30–360 Hz.
+    if (delta.ToMilliseconds() > 2.0 && delta.ToMilliseconds() < 40.0) {
+      mVsyncRate = TimeDuration::FromMilliseconds(
+          mVsyncRate.ToMilliseconds() * 0.7 + delta.ToMilliseconds() * 0.3);
+    }
+  }
+}
+
+void QtWaylandVsyncSource::RequestFrameCallbackLocked(
+    const MutexAutoLock& /*aProofOfLock*/) {
+  if (mCallbackPending || !mWindow || mIsShutdown) {
+    return;
+  }
+  QtWindowBridge* qw = mWindow->GetQtWindow();
+  if (!qw) {
+    return;
+  }
+  if (!qw->handle()) {
+    qw->create();
+  }
+  QPlatformNativeInterface* native = QGuiApplication::platformNativeInterface();
+  if (!native) {
+    return;
+  }
+  auto* surface = static_cast<wl_surface*>(
+      native->nativeResourceForWindow("surface", qw));
+  if (!surface) {
+    return;
+  }
+
+  mCallback = wl_surface_frame(surface);
+  if (!mCallback) {
+    return;
+  }
+  wl_callback_add_listener(mCallback, &kFrameListener, this);
+  mCallbackPending = true;
+  // Empty commit so the compositor schedules the next frame callback.
+  wl_surface_commit(surface);
+}
+
+void QtWaylandVsyncSource::FrameCallback(uint32_t aTime) {
+  MOZ_ASSERT(NS_IsMainThread());
+
+  TimeStamp lastVSync;
+  TimeStamp outputTimestamp;
+  RefPtr<nsWindow> window;
+  {
+    MutexAutoLock lock(mMutex);
+    mCallback = nullptr;
+    mCallbackPending = false;
+
+    if (mIsShutdown || !mVsyncEnabled || !mVsyncSourceEnabled) {
+      return;
+    }
+    if (aTime && mLastFrameTime == aTime) {
+      RequestFrameCallbackLocked(lock);
+      return;
+    }
+    mLastFrameTime = aTime;
+
+    const TimeStamp now = TimeStamp::Now();
+    CalculateVsyncRateLocked(lock, now);
+    mLastVsyncTimeStamp = lastVSync = now;
+    outputTimestamp = mLastVsyncTimeStamp + mVsyncRate;
+    window = mWindow;
+  }
+
+  if (window) {
+    window->NotifyOcclusionState(OcclusionState::VISIBLE);
+    if (window->Destroyed()) {
+      return;
+    }
+  }
+
+  NotifyVsync(lastVSync, outputTimestamp);
+
+  MutexAutoLock lock(mMutex);
+  if (mVsyncEnabled && mVsyncSourceEnabled && !mIsShutdown) {
+    RequestFrameCallbackLocked(lock);
+  }
+}
+
+void QtWaylandVsyncSource::EnableVsync() {
+  MOZ_ASSERT(NS_IsMainThread());
+  MutexAutoLock lock(mMutex);
+  if (mVsyncEnabled || mIsShutdown) {
+    return;
+  }
+  mVsyncEnabled = true;
+  if (mVsyncSourceEnabled) {
+    RequestFrameCallbackLocked(lock);
+  }
+}
+
+void QtWaylandVsyncSource::DisableVsync() {
+  MOZ_ASSERT(NS_IsMainThread());
+  MutexAutoLock lock(mMutex);
+  mVsyncEnabled = false;
+}
+
+bool QtWaylandVsyncSource::IsVsyncEnabled() {
+  MutexAutoLock lock(mMutex);
+  return mVsyncEnabled;
+}
+
+void QtWaylandVsyncSource::EnableVSyncSource() {
+  MutexAutoLock lock(mMutex);
+  mVsyncSourceEnabled = true;
+  if (mVsyncEnabled && !mIsShutdown) {
+    RequestFrameCallbackLocked(lock);
+  }
+}
+
+void QtWaylandVsyncSource::DisableVSyncSource() {
+  MutexAutoLock lock(mMutex);
+  mVsyncSourceEnabled = false;
+}
+
+void QtWaylandVsyncSource::Shutdown() {
+  MOZ_ASSERT(NS_IsMainThread());
+  MutexAutoLock lock(mMutex);
+  mIsShutdown = true;
+  mVsyncEnabled = false;
+  mVsyncSourceEnabled = false;
+  if (mCallback) {
+    wl_callback_destroy(mCallback);
+    mCallback = nullptr;
+  }
+  mCallbackPending = false;
+  mWindow = nullptr;
+}
+
+}  // namespace mozilla
diff --git a/widget/qt/QtWaylandVsyncSource.h b/widget/qt/QtWaylandVsyncSource.h
new file mode 100644
index 000000000000..f836f978c36c
--- /dev/null
+++ b/widget/qt/QtWaylandVsyncSource.h
@@ -0,0 +1,60 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef widget_qt_QtWaylandVsyncSource_h
+#define widget_qt_QtWaylandVsyncSource_h
+
+#include "mozilla/Mutex.h"
+#include "mozilla/TimeStamp.h"
+#include "VsyncSource.h"
+
+class nsWindow;
+struct wl_callback;
+struct wl_surface;
+
+namespace mozilla {
+
+// Per-window compositor vsync emulated with wl_surface frame callbacks.
+// Mirrors widget/gtk/WaylandVsyncSource without GTK/WaylandSurface deps.
+class QtWaylandVsyncSource final : public gfx::VsyncSource {
+ public:
+  explicit QtWaylandVsyncSource(nsWindow* aWindow);
+  ~QtWaylandVsyncSource() override;
+
+  TimeDuration GetVsyncRate() override;
+  void EnableVsync() override;
+  void DisableVsync() override;
+  bool IsVsyncEnabled() override;
+  void Shutdown() override;
+
+  void EnableVSyncSource();
+  void DisableVSyncSource();
+
+  // Called from the wl_callback listener (main thread via Qt event loop).
+  void FrameCallback(uint32_t aTime);
+
+ private:
+  void RequestFrameCallbackLocked(const MutexAutoLock& aProofOfLock);
+  void CalculateVsyncRateLocked(const MutexAutoLock& aProofOfLock,
+                                TimeStamp aNow);
+
+  Mutex mMutex;
+  // Main thread only except logging.
+  RefPtr<nsWindow> mWindow;
+
+  bool mIsShutdown MOZ_GUARDED_BY(mMutex) = false;
+  bool mVsyncEnabled MOZ_GUARDED_BY(mMutex) = false;
+  bool mVsyncSourceEnabled MOZ_GUARDED_BY(mMutex) = false;
+  bool mCallbackPending MOZ_GUARDED_BY(mMutex) = false;
+
+  TimeDuration mVsyncRate MOZ_GUARDED_BY(mMutex);
+  TimeStamp mLastVsyncTimeStamp MOZ_GUARDED_BY(mMutex);
+  uint32_t mLastFrameTime MOZ_GUARDED_BY(mMutex) = 0;
+
+  wl_callback* mCallback MOZ_GUARDED_BY(mMutex) = nullptr;
+};
+
+}  // namespace mozilla
+
+#endif
diff --git a/widget/qt/QtWindowBridge.cpp b/widget/qt/QtWindowBridge.cpp
new file mode 100644
index 000000000000..e46b23f511af
--- /dev/null
+++ b/widget/qt/QtWindowBridge.cpp
@@ -0,0 +1,313 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "QtWindowBridge.h"
+#include "nsWindow.h"
+
+#include <cmath>
+
+#include <QEvent>
+#include <QExposeEvent>
+#include <QResizeEvent>
+#include <QMoveEvent>
+#include <QFocusEvent>
+#include <QKeyEvent>
+#include <QMouseEvent>
+#include <QWheelEvent>
+#include <QCloseEvent>
+#include <QInputMethodEvent>
+#include <QInputMethodQueryEvent>
+#include <QDragEnterEvent>
+#include <QDragMoveEvent>
+#include <QDragLeaveEvent>
+#include <QDropEvent>
+#include <QMimeData>
+#include <QPainter>
+#include <QRegion>
+#include <QGuiApplication>
+#include <QInputMethod>
+#include <QWindowStateChangeEvent>
+#include <QSurfaceFormat>
+
+QtWindowBridge::QtWindowBridge(nsWindow* aWidget) : mWidget(aWidget) {
+  // Default: software WebRender path uses QBackingStore / raster surfaces.
+  // ConfigureForHardwarePresent() switches top-levels to exclusive EGL.
+  setSurfaceType(QSurface::RasterSurface);
+  // Advertise IM support; QWindow delivers QEvent::InputMethod* when focused.
+  setProperty("_q_inputMethodHints", int(Qt::ImhNone));
+}
+
+QtWindowBridge::~QtWindowBridge() { mWidget = nullptr; }
+
+void QtWindowBridge::ConfigureForHardwarePresent() {
+  // Keep RasterSurface so we can fall back to QBackingStore if EGL fails by
+  // destroying wl_egl_window. Exclusive present simply never paints raster
+  // while mHardwarePresent is true.
+  mHardwarePresent = true;
+  mBackingStore = nullptr;
+  mBackingStoreValid = false;
+}
+
+void QtWindowBridge::AbandonHardwarePresent() {
+  mHardwarePresent = false;
+}
+
+void QtWindowBridge::EnsureBackingStore() {
+  if (mHardwarePresent) {
+    return;
+  }
+  if (!mBackingStore) {
+    mBackingStore = mozilla::MakeUnique<QBackingStore>(this);
+  }
+  if (mBackingStore->size() != size()) {
+    mBackingStore->resize(size());
+  }
+}
+
+void QtWindowBridge::PaintLastFrameToBackingStore(const QRegion& aDamageDip) {
+  if (mHardwarePresent || mLastFrame.isNull() || !isExposed()) {
+    return;
+  }
+  EnsureBackingStore();
+  qreal dpr = mLastFrame.devicePixelRatio();
+  if (dpr <= 0.0) {
+    dpr = 1.0;
+  }
+
+  const QSizeF logical = QSizeF(mLastFrame.size()) / dpr;
+  const bool scaleMismatch = qAbs(logical.width() - width()) > 1.0 ||
+                             qAbs(logical.height() - height()) > 1.0;
+
+  QRegion paintRegion;
+  if (scaleMismatch || aDamageDip.isEmpty()) {
+    paintRegion = QRegion(0, 0, width(), height());
+  } else {
+    paintRegion = aDamageDip.intersected(QRect(0, 0, width(), height()));
+    if (paintRegion.isEmpty()) {
+      return;
+    }
+  }
+
+  mBackingStore->beginPaint(paintRegion);
+  {
+    QPainter painter(mBackingStore->paintDevice());
+    // Source overwrites dest — correct for opaque chrome and avoids blend cost.
+    painter.setCompositionMode(QPainter::CompositionMode_Source);
+    if (mTransparentBackground) {
+      for (const QRect& r : paintRegion) {
+        painter.fillRect(r, Qt::transparent);
+      }
+    }
+    if (scaleMismatch) {
+      painter.drawImage(QRectF(0, 0, width(), height()), mLastFrame);
+    } else {
+      // 1:1 DIP: only redraw damaged rects (scrolling often dirty-bands).
+      for (const QRect& r : paintRegion) {
+        const QRect src(int(std::lround(r.x() * dpr)),
+                        int(std::lround(r.y() * dpr)),
+                        int(std::lround(r.width() * dpr)),
+                        int(std::lround(r.height() * dpr)));
+        painter.drawImage(r, mLastFrame, src);
+      }
+    }
+  }
+  mBackingStore->endPaint();
+  mBackingStore->flush(paintRegion);
+  mBackingStoreValid = true;
+}
+
+void QtWindowBridge::PresentImage(QImage aImage, const QRegion& aDamageDip) {
+  if (mHardwarePresent) {
+    // EGL SwapBuffers owns presentation for this window.
+    return;
+  }
+  // Frame buffer is physical/device pixels (Gecko layout-device size).
+  // Move, do not copy — callers already own a deep buffer (or wrap one).
+  mLastFrame = std::move(aImage);
+  qreal dpr = 1.0;
+  if (mWidget) {
+    dpr = qreal(mWidget->DevicePixelRatio());
+  }
+  if (dpr <= 0.0) {
+    dpr = devicePixelRatio();
+  }
+  if (dpr <= 0.0) {
+    dpr = 1.0;
+  }
+  mLastFrame.setDevicePixelRatio(dpr);
+  PaintLastFrameToBackingStore(aDamageDip);
+  // Drop pixel storage so SWGL ring buffers can be reused (backing store holds
+  // the painted result for subsequent expose flushes).
+  mLastFrame = QImage();
+}
+
+void QtWindowBridge::FlushBackingStore() {
+  if (mHardwarePresent || !isExposed()) {
+    return;
+  }
+  if (!mLastFrame.isNull()) {
+    PaintLastFrameToBackingStore(QRegion());
+    mLastFrame = QImage();
+    return;
+  }
+  // Re-flush already-painted pixels without a full-frame QImage.
+  if (mBackingStoreValid && mBackingStore) {
+    EnsureBackingStore();
+    mBackingStore->flush(QRegion(0, 0, width(), height()));
+  }
+}
+
+bool QtWindowBridge::event(QEvent* aEvent) {
+  if (!mWidget) {
+    return QWindow::event(aEvent);
+  }
+  switch (aEvent->type()) {
+    case QEvent::InputMethod:
+      mWidget->OnInputMethodEvent(static_cast<QInputMethodEvent*>(aEvent));
+      return true;
+    case QEvent::InputMethodQuery: {
+      auto* query = static_cast<QInputMethodQueryEvent*>(aEvent);
+      mWidget->OnInputMethodQuery(query);
+      return true;
+    }
+    case QEvent::DragEnter:
+      mWidget->OnDragEnter(static_cast<QDragEnterEvent*>(aEvent));
+      return true;
+    case QEvent::DragMove:
+      mWidget->OnDragMove(static_cast<QDragMoveEvent*>(aEvent));
+      return true;
+    case QEvent::DragLeave:
+      mWidget->OnDragLeave();
+      return true;
+    case QEvent::Drop:
+      mWidget->OnDrop(static_cast<QDropEvent*>(aEvent));
+      return true;
+    case QEvent::WindowStateChange: {
+      auto* change = static_cast<QWindowStateChangeEvent*>(aEvent);
+      const bool handled = QWindow::event(aEvent);
+      mWidget->OnWindowStateChanged(int(change->oldState()),
+                                    int(windowState()));
+      return handled;
+    }
+    default:
+      break;
+  }
+  return QWindow::event(aEvent);
+}
+
+void QtWindowBridge::exposeEvent(QExposeEvent* aEvent) {
+  QWindow::exposeEvent(aEvent);
+  if (isExposed() && !mHardwarePresent) {
+    if (!mLastFrame.isNull()) {
+      FlushBackingStore();
+    } else if (mTransparentBackground) {
+      // Avoid opaque white flash for alpha popups before the first Gecko frame.
+      EnsureBackingStore();
+      mBackingStore->beginPaint(QRegion(0, 0, width(), height()));
+      {
+        QPainter painter(mBackingStore->paintDevice());
+        painter.setCompositionMode(QPainter::CompositionMode_Source);
+        painter.fillRect(QRectF(0, 0, width(), height()), Qt::transparent);
+      }
+      mBackingStore->endPaint();
+      mBackingStore->flush(QRegion(0, 0, width(), height()));
+    }
+  }
+  if (mWidget) {
+    mWidget->OnExpose();
+  }
+}
+
+void QtWindowBridge::resizeEvent(QResizeEvent* aEvent) {
+  QWindow::resizeEvent(aEvent);
+  if (!mHardwarePresent) {
+    if (mBackingStore) {
+      mBackingStore->resize(aEvent->size());
+    }
+    // Keep mBackingStoreValid / mLastFrame until the next present so Wayland
+    // configure storms do not flash an empty store between frames.
+  }
+  if (mWidget) {
+    mWidget->OnResize(aEvent->size().width(), aEvent->size().height());
+  }
+}
+
+void QtWindowBridge::moveEvent(QMoveEvent* aEvent) {
+  QWindow::moveEvent(aEvent);
+  if (mWidget) {
+    mWidget->OnMove(aEvent->pos().x(), aEvent->pos().y());
+  }
+}
+
+void QtWindowBridge::focusInEvent(QFocusEvent* aEvent) {
+  QWindow::focusInEvent(aEvent);
+  if (mWidget) {
+    mWidget->OnFocus(true);
+  }
+  if (QInputMethod* im = QGuiApplication::inputMethod()) {
+    im->update(Qt::ImQueryAll);
+  }
+}
+
+void QtWindowBridge::focusOutEvent(QFocusEvent* aEvent) {
+  QWindow::focusOutEvent(aEvent);
+  if (mWidget) {
+    mWidget->OnFocus(false);
+  }
+}
+
+void QtWindowBridge::keyPressEvent(QKeyEvent* aEvent) {
+  if (mWidget) {
+    mWidget->OnKeyEvent(aEvent, true);
+  }
+  QWindow::keyPressEvent(aEvent);
+}
+
+void QtWindowBridge::keyReleaseEvent(QKeyEvent* aEvent) {
+  if (mWidget) {
+    mWidget->OnKeyEvent(aEvent, false);
+  }
+  QWindow::keyReleaseEvent(aEvent);
+}
+
+void QtWindowBridge::mousePressEvent(QMouseEvent* aEvent) {
+  // Activate only windows that should own chrome focus. Popups, Media PiP and
+  // alerts must not steal activation (tab goes inactive, media pauses, etc.).
+  if (mWidget && mWidget->ShouldAcceptActivate()) {
+    requestActivate();
+  }
+  if (mWidget) {
+    mWidget->OnMouseEvent(aEvent, true);
+  }
+  QWindow::mousePressEvent(aEvent);
+}
+
+void QtWindowBridge::mouseReleaseEvent(QMouseEvent* aEvent) {
+  if (mWidget) {
+    mWidget->OnMouseEvent(aEvent, false);
+  }
+  QWindow::mouseReleaseEvent(aEvent);
+}
+
+void QtWindowBridge::mouseMoveEvent(QMouseEvent* aEvent) {
+  if (mWidget) {
+    mWidget->OnMouseMove(aEvent);
+  }
+  QWindow::mouseMoveEvent(aEvent);
+}
+
+void QtWindowBridge::wheelEvent(QWheelEvent* aEvent) {
+  if (mWidget) {
+    mWidget->OnWheelEvent(aEvent);
+  }
+  QWindow::wheelEvent(aEvent);
+}
+
+void QtWindowBridge::closeEvent(QCloseEvent* aEvent) {
+  if (mWidget && mWidget->OnClose()) {
+    aEvent->ignore();
+    return;
+  }
+  QWindow::closeEvent(aEvent);
+}
diff --git a/widget/qt/QtWindowBridge.h b/widget/qt/QtWindowBridge.h
new file mode 100644
index 000000000000..2ccb80b117f5
--- /dev/null
+++ b/widget/qt/QtWindowBridge.h
@@ -0,0 +1,85 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef widget_qt_QtWindowBridge_h
+#define widget_qt_QtWindowBridge_h
+
+#pragma GCC visibility push(default)
+#include <QWindow>
+#include <QObject>
+#include <QImage>
+#include <QBackingStore>
+#include <QRegion>
+#pragma GCC visibility pop
+
+#include "mozilla/UniquePtr.h"
+
+class nsWindow;
+
+// QWindow subclass that forwards native events to nsWindow.
+class QtWindowBridge final : public QWindow {
+  Q_OBJECT
+ public:
+  explicit QtWindowBridge(nsWindow* aWidget);
+  ~QtWindowBridge() override;
+
+  nsWindow* GetWidget() const { return mWidget; }
+  void ClearWidget() { mWidget = nullptr; }
+
+  // Exclusive EGL present: skip QBackingStore while true. Raster surface type
+  // is kept so we can fall back if wl_egl_window/EGL fails.
+  void ConfigureForHardwarePresent();
+  void AbandonHardwarePresent();
+  bool UsesHardwarePresent() const { return mHardwarePresent; }
+
+  // Present a premultiplied ARGB32 image into the window (main thread only).
+  // Takes ownership via move — callers should pass an owned QImage (or one
+  // that keeps its buffer alive via QImage cleanup function).
+  // aDamageDip is in window device-independent pixels; empty = full window.
+  // No-op when UsesHardwarePresent() (EGL SwapBuffers owns presentation).
+  void PresentImage(QImage aImage, const QRegion& aDamageDip = QRegion());
+
+  // True after at least one PresentImage call (used to decide first expose).
+  bool HasPresentedFrame() const {
+    return mHardwarePresent || mBackingStoreValid || !mLastFrame.isNull();
+  }
+
+  // When true, clear the backing store to transparent each present so
+  // rounded popup panels don't leave an opaque black frame.
+  void SetTransparentBackground(bool aTransparent) {
+    mTransparentBackground = aTransparent;
+  }
+
+ protected:
+  bool event(QEvent* aEvent) override;
+  void exposeEvent(QExposeEvent* aEvent) override;
+  void resizeEvent(QResizeEvent* aEvent) override;
+  void moveEvent(QMoveEvent* aEvent) override;
+  void focusInEvent(QFocusEvent* aEvent) override;
+  void focusOutEvent(QFocusEvent* aEvent) override;
+  void keyPressEvent(QKeyEvent* aEvent) override;
+  void keyReleaseEvent(QKeyEvent* aEvent) override;
+  void mousePressEvent(QMouseEvent* aEvent) override;
+  void mouseReleaseEvent(QMouseEvent* aEvent) override;
+  void mouseMoveEvent(QMouseEvent* aEvent) override;
+  void wheelEvent(QWheelEvent* aEvent) override;
+  void closeEvent(QCloseEvent* aEvent) override;
+  // QWindow has no dedicated IME/DnD virtuals; handle via event().
+
+ private:
+  void EnsureBackingStore();
+  void FlushBackingStore();
+  void PaintLastFrameToBackingStore(const QRegion& aDamageDip = QRegion());
+
+  nsWindow* mWidget;
+  mozilla::UniquePtr<QBackingStore> mBackingStore;
+  QImage mLastFrame;
+  bool mTransparentBackground = false;
+  // True once the backing store has been painted; expose can flush without
+  // retaining the full-frame QImage (frees SWGL buffers sooner).
+  bool mBackingStoreValid = false;
+  bool mHardwarePresent = false;
+};
+
+#endif
diff --git a/widget/qt/ScreenHelperQt.cpp b/widget/qt/ScreenHelperQt.cpp
new file mode 100644
index 000000000000..1ec0237e50ce
--- /dev/null
+++ b/widget/qt/ScreenHelperQt.cpp
@@ -0,0 +1,155 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "ScreenHelperQt.h"
+
+#include "mozilla/RefPtr.h"
+#include "mozilla/widget/Screen.h"
+#include "nsTArray.h"
+
+#include <cmath>
+
+#include <QGuiApplication>
+#include <QScreen>
+
+
+namespace mozilla::widget {
+
+static constexpr float kMMPerInch = 25.4f;
+
+float PhysicalDpiForQScreen(QScreen* aScreen) {
+  if (!aScreen) {
+    return 96.0f;
+  }
+  const qreal dpr =
+      aScreen->devicePixelRatio() > 0.0 ? aScreen->devicePixelRatio() : 1.0;
+  const float fallback = float(96.0 * dpr);
+
+  const QSizeF mm = aScreen->physicalSize();
+  const QRect g = aScreen->geometry();
+  // Gecko layout-device height = DIP geometry * scale.
+  const int deviceHeight = int(std::lround(double(g.height()) * dpr));
+  if (mm.height() <= 0.0 || deviceHeight <= 0) {
+    const float phys = float(aScreen->physicalDotsPerInch());
+    if (phys >= fallback * 0.5f && phys <= fallback * 2.0f) {
+      return phys;
+    }
+    return fallback;
+  }
+
+  auto dpiFromMmHeight = [deviceHeight](qreal mmHeight) -> float {
+    return float(deviceHeight) / (float(mmHeight) / kMMPerInch);
+  };
+
+  // 1) Compositor reports true millimetres.
+  const float dpiRaw = dpiFromMmHeight(mm.height());
+  // 2) Some HiDPI Wayland setups (observed on scaled TVs) report physicalSize
+  // ~dpr times too large in each axis — undo that.
+  const float dpiScaledMm =
+      dpr > 1.0 ? dpiFromMmHeight(mm.height() / dpr) : dpiRaw;
+
+  auto nearFallback = [fallback](float dpi) {
+    return dpi >= fallback * 0.5f && dpi <= fallback * 2.0f;
+  };
+  // Prefer the reading closer to 96*dpr among plausible values. Large
+  // displays legitimately sit well below 96*dpr (e.g. ~100–160 on a 4K TV
+  // at 2× UI scale); still reject extreme nonsense (~37–74 from unscaled
+  // double-sized mm).
+  auto score = [fallback](float dpi) {
+    return std::abs(dpi - fallback);
+  };
+
+  float best = fallback;
+  float bestScore = score(fallback);
+  for (float candidate : {dpiRaw, dpiScaledMm}) {
+    if (!nearFallback(candidate)) {
+      continue;
+    }
+    const float s = score(candidate);
+    if (s < bestScore) {
+      best = candidate;
+      bestScore = s;
+    }
+  }
+  return best;
+}
+
+ScreenHelperQt::ScreenHelperQt() {
+  if (auto* app = qGuiApp) {
+    connect(app, &QGuiApplication::screenAdded, this,
+            &ScreenHelperQt::RefreshScreens);
+    connect(app, &QGuiApplication::screenRemoved, this,
+            &ScreenHelperQt::RefreshScreens);
+    connect(app, &QGuiApplication::primaryScreenChanged, this,
+            &ScreenHelperQt::RefreshScreens);
+  }
+  RefreshScreens();
+}
+
+ScreenHelperQt::~ScreenHelperQt() {
+  if (auto* app = qGuiApp) {
+    disconnect(app, nullptr, this, nullptr);
+  }
+}
+
+void ScreenHelperQt::RefreshScreens() {
+  AutoTArray<RefPtr<Screen>, 4> screens;
+  const bool isWayland = QGuiApplication::platformName().contains(
+      QLatin1String("wayland"), Qt::CaseInsensitive);
+  const auto qscreens = QGuiApplication::screens();
+  for (QScreen* qs : qscreens) {
+    if (!qs) {
+      continue;
+    }
+
+    // QScreen geometry is in device-independent pixels; Gecko screen rects
+    // are in layout-device (physical) pixels.
+    const qreal dpr = qs->devicePixelRatio() > 0.0 ? qs->devicePixelRatio() : 1.0;
+    // On Wayland, use available geometry as the screen rect (GTK does the
+    // same) and zero the origin so multi-monitor offsets do not push menus
+    // and popups outside the window (see GTK bug 1795066).
+    const QRect g = isWayland ? qs->availableGeometry() : qs->geometry();
+    const QRect ag = qs->availableGeometry();
+    auto toDevice = [dpr](const QRect& r) {
+      return LayoutDeviceIntRect(
+          int32_t(std::lround(r.x() * dpr)),
+          int32_t(std::lround(r.y() * dpr)),
+          int32_t(std::lround(r.width() * dpr)),
+          int32_t(std::lround(r.height() * dpr)));
+    };
+    LayoutDeviceIntRect rect = toDevice(g);
+    LayoutDeviceIntRect avail = toDevice(ag);
+    if (isWayland) {
+      rect.MoveTo(0, 0);
+      avail.MoveTo(0, 0);
+    }
+
+    const float dpi = PhysicalDpiForQScreen(qs);
+
+    const DesktopToLayoutDeviceScale contentsScale(dpr);
+    // CSS pixels -> layout device pixels must use the same scale so text and
+    // content are rasterized at full device resolution (not upscaled later).
+    const CSSToLayoutDeviceScale cssScale(dpr);
+
+    int refreshRate = 0;
+    const int mHz = qs->refreshRate();
+    if (mHz > 0) {
+      refreshRate = mHz;
+    }
+
+    screens.AppendElement(MakeRefPtr<Screen>(
+        rect, avail, 24, 24, uint32_t(refreshRate), contentsScale, cssScale,
+        dpi, Screen::IsPseudoDisplay::No, Screen::IsHDR::No));
+  }
+  if (screens.IsEmpty()) {
+    LayoutDeviceIntRect rect(0, 0, 1920, 1080);
+    screens.AppendElement(MakeRefPtr<Screen>(
+        rect, rect, 24, 24, 0, DesktopToLayoutDeviceScale(1.0),
+        CSSToLayoutDeviceScale(1.0), 96.0f, Screen::IsPseudoDisplay::No,
+        Screen::IsHDR::No));
+  }
+  ScreenManager::Refresh(std::move(screens));
+}
+
+}  // namespace mozilla::widget
