+NS_IMETHODIMP
+nsDesktopMimeApp::SetAsDefaultForURIScheme(const nsACString& aURIScheme) {
+  nsAutoCString mime("x-scheme-handler/");
+  mime.Append(aURIScheme);
+  return SetAsDefaultForMimeType(mime);
+}
