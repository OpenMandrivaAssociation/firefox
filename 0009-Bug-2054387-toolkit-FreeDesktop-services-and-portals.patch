+  if (mSynthetic) {
+    return ExpandAndLaunchExec(mEntry.exec, mEntry.name, mEntry.icon,
+                               ""_ns, spec, /*aIsFilePath=*/false);
+  }
+  return LaunchDesktopEntry(mEntry, spec, /*aIsFilePath=*/false);
+}
